PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nagham
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Comma-separated list of allowed origins. Capacitor apps use capacitor://localhost and http://localhost
CLIENT_ORIGINS=http://localhost:5173,http://localhost,capacitor://localhost,https://localhost
# Max upload size per audio file in MB
MAX_UPLOAD_MB=60
